/**
 * @file credentials.local.h.example
 * @brief 本地开发凭证配置模板（示例）
 * 
 * ⚠️ 重要说明：
 * 1. 复制此文件为 credentials.local.h
 * 2. 填写你的真实凭证信息
 * 3. 此文件已被 .gitignore 保护，不会被提交到 Git
 * 
 * 📁 使用方法：
 *    cp credentials.local.h.example credentials.local.h
 *    # 然后编辑 credentials.local.h 填写真实信息
 * 
 * 🔒 安全提示：
 * - 绝对不要将填写后的 credentials.local.h 提交到公开仓库
 * - 此文件包含敏感信息，仅用于本地编译
 * - 如需分享代码，只需分享 .example 文件即可
 * 
 * @author ESP32 Environment Monitor
 * @version 1.4.0
 * @date 2026-09-10
 */

#ifndef CREDENTIALS_LOCAL_H
#define CREDENTIALS_LOCAL_H

#ifdef __cplusplus
extern "C" {
#endif

/* ===========================================
 * 🌐 WiFi 配置
 * =========================================== */

/**
 * WiFi SSID (网络名称)
 * 示例: "HUAWEI-5FEC", "MyHomeNetwork"
 */
#define LOCAL_WIFI_SSID      "YOUR_WIFI_SSID"

/**
 * WiFi 密码
 * 示例: "your_wifi_password"
 */
#define LOCAL_WIFI_PASS      "YOUR_WIFI_PASSWORD"

/**
 * WiFi 最大重试次数 (可选，默认10)
 */
#define LOCAL_WIFI_MAX_RETRY 10


/* ===========================================
 * ☁️ MQTT 配置 (EMQX Cloud)
 * =========================================== */

/**
 * MQTT Broker URI
 * 格式: "mqtts://broker-host:port"
 * 示例: "mqtts://your-broker.emqxsl.cn:8883"
 */
#define LOCAL_MQTT_BROKER_URI  "mqtts://YOUR_MQTT_BROKER:8883"

/**
 * MQTT 用户名
 * 示例: "your_username"
 */
#define LOCAL_MQTT_USERNAME    "YOUR_MQTT_USERNAME"

/**
 * MQTT 密码
 * 示例: "your_mqtt_password"
 */
#define LOCAL_MQTT_PASSWORD    "YOUR_MQTT_PASSWORD"


/* ===========================================
 * 📊 InfluxDB Cloud 配置
 * =========================================== */

/**
 * InfluxDB URL (HTTP API)
 * 格式: "https://your-region.cloud2.influxdata.com"
 * 示例: "https://us-east-1-1.aws.cloud2.influxdata.com"
 */
#define LOCAL_INFLUXDB_URL    "https://YOUR_INFLUXDB_URL"

/**
 * InfluxDB Host (用于 DNS 解析)
 * 通常与 URL 的主机名相同
 */
#define LOCAL_INFLUXDB_HOST   "YOUR_INFLUXDB_URL"

/**
 * InfluxDB Organization 名称
 * 示例: "Fellowes", "my-org"
 */
#define LOCAL_INFLUXDB_ORG    "YOUR_ORG_NAME"

/**
 * InfluxDB Bucket 名称 (数据库名)
 * 示例: "sensor_data"
 */
#define LOCAL_INFLUXDB_BUCKET "sensor_data"

/**
 * InfluxDB API Token
 * 示例: "your_long_api_token_string_here"
 * 
 * ⚠️ 这是一个很长的字符串，确保完整复制
 */
#define LOCAL_INFLUXDB_TOKEN  "YOUR_INFLUXDB_TOKEN"


/* ===========================================
 * 📱 微信小程序配置 (可选)
 * =========================================== */

/**
 * 小程序使用的 InfluxDB URL
 * 如果与 ESP32 相同，可直接复制上面的值
 */
#define LOCAL_MINIPROGRAM_INFLUXDB_URL    "https://YOUR_INFLUXDB_URL"

/**
 * 小程序使用的 InfluxDB Organization
 */
#define LOCAL_MINIPROGRAM_INFLUXDB_ORG    "YOUR_ORG_NAME"

/**
 * 小程序使用的 InfluxDB Bucket
 */
#define LOCAL_MINIPROGRAM_INFLUXDB_BUCKET "sensor_data"

/**
 * 小程序使用的 InfluxDB Token
 */
#define LOCAL_MINIPROGRAM_INFLUXDB_TOKEN  "YOUR_INFLUXDB_TOKEN"


/* ===========================================
 * 🔧 高级配置 (可选)
 * =========================================== */

/**
 * 是否启用调试日志输出凭证信息 (⚠️ 仅用于调试！)
 * 0 = 关闭 (推荐，生产环境)
 * 1 = 开启 (仅开发调试用)
 * 
 * ⚠️ 警告：开启后日志中会显示凭证，请勿在生产环境使用！
 */
#define LOCAL_CREDENTIALS_DEBUG 0


/* ===========================================
 * ✅ 配置验证宏 (不要修改)
 * =========================================== */

/**
 * 检查必要配置是否已填写
 * 编译时会给出警告或错误提示
 */

#if !defined(LOCAL_WIFI_SSID) || (LOCAL_WIFI_SSID[0] == 'Y' && LOCAL_WIFI_SSID[1] == 'O' && LOCAL_WIFI_SSID[2] == 'U')
    #warning "⚠️ LOCAL_WIFI_SSID 未配置！请编辑 credentials.local.h 填写真实的 WiFi SSID"
#endif

#if !defined(LOCAL_WIFI_PASS) || (LOCAL_WIFI_PASS[0] == 'Y' && LOCAL_WIFI_PASS[1] == 'O' && LOCAL_WIFI_PASS[2] == 'U')
    #warning "⚠️ LOCAL_WIFI_PASS 未配置！请编辑 credentials.local.h 填写真实的 WiFi 密码"
#endif

#if !defined(LOCAL_MQTT_BROKER_URI) || (LOCAL_MQTT_BROKER_URI[0] == 'm' && LOCAL_MQTT_BROKER_URI[9] == 'Y')
    #warning "⚠️ LOCAL_MQTT_BROKER_URI 未配置！请编辑 credentials.local.h 填写真实的 MQTT Broker URI"
#endif

#if !defined(LOCAL_INFLUXDB_URL) || (LOCAL_INFLUXDB_URL[0] == 'h' && LOCAL_INFLUXDB_URL[8] == 'Y')
    #warning "⚠️ LOCAL_INFLUXDB_URL 未配置！请编辑 credentials.local.h 填写真实的 InfluxDB URL"
#endif

#if !defined(LOCAL_INFLUXDB_TOKEN) || (LOCAL_INFLUXDB_TOKEN[0] == 'Y')
    #error "❌ LOCAL_INFLUXDB_TOKEN 未配置！InfluxDB Token 是必需的，请填写真实值"
#endif


#ifdef __cplusplus
}
#endif

#endif /* CREDENTIALS_LOCAL_H */


/* ===========================================
 * 📖 使用说明
 * =========================================== 
 * 
 * 快速开始：
 * 
 * 1. 复制模板：
 *    $ cp credentials.local.h.example credentials.local.h
 * 
 * 2. 编辑配置：
 *    $ nano credentials.local.h  # 或使用任何文本编辑器
 * 
 * 3. 填写所有 YOUR_XXX 占位符为你的真实凭证
 * 
 * 4. 编译项目：
 *    $ idf.py build
 * 
 * 5. 验证配置（可选）：
 *    $ idf.py monitor  # 查看连接状态
 * 
 * 
 * 🔐 安全最佳实践：
 * 
 * ✅ DO (推荐做法):
 * - 将 credentials.local.h 添加到 .gitignore (已默认添加)
 * - 在团队中通过安全渠道共享此文件 (如密码管理器)
 * - 定期更换 Token 和密码
 * - 使用不同的开发/生产环境凭证
 * 
 * ❌ DON'T (禁止做法):
 * - 将此文件提交到 Git 仓库
 * - 在日志中打印凭证信息 (除非 LOCAL_CREDENTIALS_DEBUG=1)
 * - 与他人明文共享此文件
 * - 在公共场合展示此文件内容
 * 
 * 
 * 🔄 多环境支持：
 * 
 * 你可以为不同环境创建不同的配置文件：
 * - credentials.local.h        (默认，本地开发)
 * - credentials.staging.h      (测试环境)
 * - credentials.production.h   (生产环境)
 * 
 * 然后在编译时通过宏选择：
 * $ idf.py build -D CREDENTIALS_FILE=credentials.production.h
 * 
 * 
 * 🐛 故障排除：
 * 
 * Q: 编译时出现 "undefined reference" 错误？
 * A: 确保 credentials.local.h 文件存在且路径正确
 * 
 * Q: WiFi 连接失败？
 * A: 检查 LOCAL_WIFI_SSID 和 LOCAL_WIFI_PASS 是否正确
 * 
 * Q: MQTT 连接超时？
 * A: 检查 LOCAL_MQTT_BROKER_URI 格式是否正确 (mqtts://host:port)
 * 
 * Q: InfluxDB 写入失败？
 * A: 检查 LOCAL_INFLUXDB_TOKEN 是否有效且未过期
 * 
 * 
 * 📞 需要帮助？
 * 
 * - 查看 README.md 了解完整配置说明
 * - 查看 CONFIG.example.md 获取详细教程
 * - 运行 bash scripts/security-check.sh 检查安全性
 * - 在 GitHub Issues 提问
 * 
 * 
 * 📅 最后更新: 2026-09-10
 * 👤 维护者: ESP32 Environment Monitor Team
 * 🌐 项目: https://github.com/Jefferysun7972/esp32-environment-monitor
 * =========================================== */