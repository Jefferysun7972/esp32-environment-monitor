.container {
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 100rpx;
}

.controls {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
  margin-bottom: 14rpx;
  margin-top: 8rpx;
}

.section-title:first-child {
  margin-top: 0;
}

.chip-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.chip-row.wrap {
  flex-wrap: wrap;
}

.chip {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: #f0f0f0;
  color: #666;
  transition: all 0.2s;
}

.chip.active {
  background: #1a73e8;
  color: #fff;
}

.chart-container {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  min-height: 260rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chart-canvas {
  display: block;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 16rpx;
}

.loading {
  color: #999;
  font-size: 28rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #bbb;
}

.stats-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  gap: 20rpx;
}

.stats-card {
  flex: 1;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 16rpx;
}

.stats-sensor {
  font-size: 22rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.stats-row {
  display: flex;
  justify-content: space-between;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-label {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.stats-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
}

.stats-value.min {
  color: #1a73e8;
}

.stats-value.max {
  color: #e53935;
}

.stats-value.avg {
  color: #ff6d00;
}

.table-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.table-title-row .section-title {
  margin-bottom: 0;
}

.export-btn {
  font-size: 22rpx;
  color: #1a73e8;
  padding: 6rpx 16rpx;
  border: 1rpx solid #1a73e8;
  border-radius: 20rpx;
}

.data-table {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.table-header {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eee;
}

.table-header text {
  font-size: 24rpx;
  color: #999;
  font-weight: 600;
}

.table-body {
  max-height: 400rpx;
}

.table-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.col-time {
  flex: 1.3;
  font-size: 22rpx;
  color: #666;
}

.col-val {
  flex: 1;
  font-size: 22rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}