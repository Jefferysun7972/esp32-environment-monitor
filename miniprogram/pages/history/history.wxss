page {
  background: #f5f5f5;
}

.container {
  background: #f5f5f5;
  min-height: 100vh;
  min-height: 100dvh;
  padding-bottom: 100rpx;
  box-sizing: border-box;
}

/* Header */
.header {
  position: relative;
  padding: 120rpx 40rpx 40rpx;
  margin: 0 -24rpx 24rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: -80rpx;
  left: -40rpx;
  right: -40rpx;
  bottom: 0;
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-content {
  position: relative;
  z-index: 1;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}

.controls {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
  margin-bottom: 14rpx;
  margin-top: 20rpx;
}

.section-title:first-child {
  margin-top: 0;
}

.chip-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.chip-row.wrap {
  flex-wrap: wrap;
}

.chip {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: transparent;
  border: 2rpx solid #ccc;
  color: #666;
  transition: all 0.2s;
}

.chip.active {
  color: #fff;
}

.chip.disabled {
  border-color: #e0e0e0;
  color: #c0c0c0;
  opacity: 0.6;
}

.unit-dropdown {
  margin-top: 4rpx;
}

.chip.sub {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  background: transparent;
}

.chip.sub.active {
  color: #fff;
}

.chart-container {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 0 24rpx 24rpx;
  min-height: 260rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.chart-canvas {
  display: block;
}

.pinch-hint {
  position: absolute;
  bottom: 6rpx;
  right: 20rpx;
  font-size: 18rpx;
  color: #bbb;
  pointer-events: none;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 16rpx;
}

.loading {
  color: #999;
  font-size: 28rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #bbb;
}

.stats-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stats-grid {
  display: flex;
  gap: 20rpx;
}

.stats-card {
  flex: 1;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 16rpx;
}

.stats-sensor {
  font-size: 22rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.stats-row {
  display: flex;
  justify-content: space-between;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-label {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.stats-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
}

.stats-value.min {
  color: #1a73e8;
}

.stats-value.max {
  color: #e53935;
}

.stats-value.avg {
  color: #ff6d00;
}

.table-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.table-title-row .section-title {
  margin-bottom: 0;
}

.export-btn {
  font-size: 22rpx;
  color: #1a73e8;
  padding: 6rpx 16rpx;
  border: 1rpx solid #1a73e8;
  border-radius: 20rpx;
}

.data-table {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.table-header {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eee;
}

.table-header text {
  font-size: 24rpx;
  color: #999;
  font-weight: 600;
}

.table-body {
  max-height: 400rpx;
}

.table-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.col-time {
  flex: 1.3;
  font-size: 22rpx;
  color: #666;
}

.col-val {
  flex: 1;
  font-size: 22rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

/* Export Modal */
.export-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.export-modal-panel {
  width: 580rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
}

.export-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  text-align: center;
}

.export-modal-hint {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin: 8rpx 0 16rpx;
}

.export-range-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.export-range-label {
  font-size: 24rpx;
  color: #666;
}

.export-range-chip {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #f0f0f0;
  color: #666;
}

.export-range-chip.active {
  background: #1a73e8;
  color: #fff;
}

.export-modal-list {
  max-height: 500rpx;
}

.export-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: #f8f9fa;
}

.export-item.checked {
  background: #e3f2fd;
}

.export-checkbox {
  font-size: 36rpx;
  margin-right: 16rpx;
  color: #1a73e8;
}

.export-item.checked .export-checkbox {
  color: #1a73e8;
}

.export-item-label {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.export-item-unit {
  font-size: 24rpx;
  color: #999;
}

.export-modal-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.export-select-all {
  font-size: 26rpx;
  color: #1a73e8;
  padding: 8rpx 0;
}

.export-btns {
  display: flex;
  gap: 20rpx;
}

.export-btn-cancel {
  font-size: 26rpx;
  color: #999;
  padding: 12rpx 32rpx;
  border-radius: 20rpx;
  background: #f0f0f0;
}

.export-btn-confirm {
  font-size: 26rpx;
  color: #fff;
  padding: 12rpx 32rpx;
  border-radius: 20rpx;
  background: #1a73e8;
}

/* Dark Mode - 完整优化 */
page .container.theme-dark,
.container.theme-dark {
  background: #1a1a2e !important;
}

/* 强制覆盖 page 元素背景 */
page[style*="background: rgb(26, 26, 46)"] {
  background: #1a1a2e !important;
}

.theme-dark .header-bg {
  background: linear-gradient(135deg, #0d47a1 0%, #0a0a1a 100%) !important;
}

.theme-dark .header-title,
.theme-dark .header-subtitle {
  color: #e0e0e0;
}

/* 控制面板优化 */
.theme-dark .controls {
  background: #252540;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}

.theme-dark .section-title {
  color: #bbb;
  font-weight: 600;
}

/* 芯片/按钮优化 */
.theme-dark .chip {
  background: transparent;
  color: #aaa;
  border: 2rpx solid #555;
  transition: all 0.2s ease;
}

.theme-dark .chip.active {
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.theme-dark .chip.disabled {
  background: transparent;
  color: #555;
  border-color: #333;
  opacity: 0.5;
}

.theme-dark .chip.sub {
  background: transparent;
  color: #999;
  border: 2rpx solid #555;
}

.theme-dark .chip.sub.active {
  color: #fff;
}

/* 图表容器优化 */
.theme-dark .chart-container {
  background: #252540;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.theme-dark .pinch-hint {
  color: #666;
  font-size: 18rpx;
}

/* 覆盖层/加载状态优化 */
.theme-dark .overlay {
  background: #252540;
  border-radius: 16rpx;
}

.theme-dark .overlay .loading,
.theme-dark .overlay .empty-text {
  color: #aaa;
  font-size: 28rpx;
}

.theme-dark .overlay .empty-hint {
  color: #777;
  font-size: 24rpx;
}

/* 统计栏优化 */
.theme-dark .stats-bar {
  background: #252540;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.theme-dark .stats-card {
  background: #2a2a45;
  border: 1rpx solid rgba(255, 255, 255, 0.03);
  transition: all 0.2s ease;
}

.theme-dark .stats-card:hover {
  border-color: rgba(255, 255, 255, 0.08);
  background: #303050;
}

.theme-dark .stats-sensor {
  color: #ddd;
  font-weight: 700;
}

.theme-dark .stats-label {
  color: #888;
}

.theme-dark .stats-value {
  color: #e0e0e0;
  font-weight: 700;
}

.theme-dark .stats-value.min {
  color: #64b5f6;
}

.theme-dark .stats-value.max {
  color: #ef9a9a;
}

.theme-dark .stats-value.avg {
  color: #ffb74d;
}

/* 数据表格优化 */
.theme-dark .data-table {
  background: #252540;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.theme-dark .table-header {
  background: #2a2a45;
  border-bottom: 2rpx solid #333;
}

.theme-dark .table-header text {
  color: #bbb;
  font-weight: 600;
}

.theme-dark .table-row {
  border-bottom-color: #2a2a45;
  transition: background 0.15s ease;
}

.theme-dark .table-row:hover {
  background: #2d2d4a;
}

.theme-dark .col-time {
  color: #aaa;
}

.theme-dark .col-val {
  color: #ddd;
  font-weight: 600;
}

/* 导出按钮优化 */
.theme-dark .export-btn {
  color: #64b5f6;
  border-color: #64b5f6;
  background: rgba(100, 181, 246, 0.08);
  transition: all 0.2s ease;
}

.theme-dark .export-btn:active {
  background: rgba(100, 181, 246, 0.15);
  transform: scale(0.98);
}

/* 导出模态框优化 */
.theme-dark .export-modal {
  background: rgba(0, 0, 0, 0.7);
}

.theme-dark .export-modal-panel {
  background: #252540;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.theme-dark .export-modal-title {
  color: #f0f0f0;
  font-weight: 700;
}

.theme-dark .export-modal-hint {
  color: #888;
}

.theme-dark .export-range-label {
  color: #aaa;
}

.theme-dark .export-range-chip {
  background: #2a2a45;
  color: #aaa;
  border: 1rpx solid transparent;
  transition: all 0.2s ease;
}

.theme-dark .export-range-chip.active {
  background: #1a73e8;
  color: #fff;
  border-color: #1a73e8;
}

.theme-dark .export-item {
  background: #2a2a45;
  border: 1rpx solid transparent;
  transition: all 0.2s ease;
}

.theme-dark .export-item:hover {
  background: #303050;
  border-color: rgba(255, 255, 255, 0.05);
}

.theme-dark .export-item.checked {
  background: #1a3a5c;
  border-color: rgba(26, 115, 232, 0.3);
}

.theme-dark .export-checkbox {
  color: #64b5f6;
}

.theme-dark .export-item-label {
  color: #ddd;
  font-weight: 500;
}

.theme-dark .export-item-unit {
  color: #888;
}

.theme-dark .export-modal-actions {
  border-top-color: #333;
}

.theme-dark .export-select-all {
  color: #64b5f6;
}

.theme-dark .export-btn-cancel {
  background: #333;
  color: #aaa;
  border: 1rpx solid transparent;
  transition: all 0.2s ease;
}

.theme-dark .export-btn-cancel:active {
  background: #3a3a55;
}

.theme-dark .export-btn-confirm {
  background: #1a73e8;
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(26, 115, 232, 0.3);
  transition: all 0.2s ease;
}

.theme-dark .export-btn-confirm:active {
  background: #1565c0;
  transform: scale(0.98);
}

/* 高对比度模式 */
.container.high-contrast .section-title {
  color: #333;
  font-weight: 700;
}

.container.theme-dark.high-contrast .section-title {
  color: #fff;
  font-weight: 700;
}

.container.high-contrast .chip {
  color: #333;
  font-weight: 600;
}

.container.theme-dark.high-contrast .chip {
  color: #e0e0e0;
  font-weight: 600;
}

.container.high-contrast .stats-sensor {
  color: #000;
  font-weight: 700;
}

.container.theme-dark.high-contrast .stats-sensor {
  color: #fff;
  font-weight: 700;
}

.container.high-contrast .stats-value {
  color: #000;
  font-weight: 700;
}

.container.theme-dark.high-contrast .stats-value {
  color: #fff;
  font-weight: 700;
}

.container.high-contrast .col-time {
  color: #333;
  font-weight: 600;
}

.container.theme-dark.high-contrast .col-time {
  color: #ddd;
  font-weight: 600;
}

.container.high-contrast .col-val {
  color: #000;
  font-weight: 700;
}

.container.theme-dark.high-contrast .col-val {
  color: #fff;
  font-weight: 700;
}