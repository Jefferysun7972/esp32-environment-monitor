<view class="container {{pageTheme === 'dark' ? 'theme-dark' : ''}}">
  <view class="controls">
    <view class="section-title">时间范围</view>
    <view class="chip-row wrap">
      <view
        wx:for="{{ranges}}"
        wx:key="key"
        class="chip {{selectedRange === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onRangeTap"
      >{{item.label}}</view>
    </view>

    <view class="section-title">指标选择</view>
    <view class="chip-row wrap">
      <view
        class="chip temp-chip {{selectedMetric === 'temp' ? 'active' : ''}}"
        bindtap="onTempChipTap"
      >温度({{tempUnit}}) {{tempDropdownOpen ? '▴' : '▾'}}</view>
      <block wx:for="{{metrics}}" wx:key="key">
        <view
          wx:if="{{item.key !== 'temp'}}"
          class="chip {{selectedMetric === item.key ? 'active' : ''}} {{!item.supported ? 'disabled' : ''}}"
          data-key="{{item.key}}"
          bindtap="{{item.supported ? 'onMetricTap' : ''}}"
        >{{item.label}}</view>
      </block>
    </view>
    <view class="chip-row wrap unit-dropdown" wx:if="{{tempDropdownOpen}}">
      <view
        class="chip sub {{tempUnit === '°C' ? 'active' : ''}}"
        data-unit="°C"
        bindtap="onTempUnitChange"
      >°C 摄氏度</view>
      <view
        class="chip sub {{tempUnit === '°F' ? 'active' : ''}}"
        data-unit="°F"
        bindtap="onTempUnitChange"
      >°F 华氏度</view>
    </view>
  </view>

  <view class="chart-container">
    <canvas
      type="2d"
      id="historyCanvas"
      class="chart-canvas"
      style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
      bindtouchstart="onCanvasTouch"
      bindtouchmove="onCanvasTouch"
      bindtouchend="onCanvasTouchEnd"
    ></canvas>
    <text class="pinch-hint" wx:if="{{chartData && chartData.length > 0}}">双指缩放切换时间范围</text>
    <view wx:if="{{loading}}" class="overlay">
      <text class="loading">加载中...</text>
    </view>
    <view wx:elif="{{!chartData || chartData.length === 0}}" class="overlay">
      <text class="empty-text">暂无数据</text>
      <text class="empty-hint">请确保 ESP32 正在运行</text>
    </view>
  </view>

  <view class="stats-bar" wx:if="{{stats}}">
    <view class="section-title">统计摘要</view>
    <view class="stats-grid">
      <view class="stats-card" wx:for="{{sensors}}" wx:key="id" wx:if="{{showSensor[index]}}">
        <text class="stats-sensor">{{item.label}} ({{metricUnit}})</text>
        <view class="stats-row">
          <view class="stats-item">
            <text class="stats-label">最小</text>
            <text class="stats-value min">{{stats[item.id].min}}</text>
          </view>
          <view class="stats-item">
            <text class="stats-label">最大</text>
            <text class="stats-value max">{{stats[item.id].max}}</text>
          </view>
          <view class="stats-item">
            <text class="stats-label">平均</text>
            <text class="stats-value avg">{{stats[item.id].avg}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="data-table" wx:if="{{tableData && tableData.length > 0}}">
    <view class="table-title-row">
    <view class="section-title">数据明细</view>
    <view class="export-btn" bindtap="onExportCsv">导出 CSV</view>
  </view>

    <view class="table-header">
      <text class="col-time">时间</text>
      <text wx:for="{{sensors}}" wx:key="id" class="col-val">{{item.label}}</text>
    </view>
    <scroll-view scroll-y class="table-body">
      <view
        wx:for="{{tableData}}"
        wx:key="displayTime"
        wx:for-item="row"
        class="table-row"
      >
        <text class="col-time">{{row.displayTime}}</text>
        <text wx:for="{{row.measurements}}" wx:key="*this" class="col-val">{{item !== null ? item : '--'}} {{metricUnit}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="export-modal" wx:if="{{exportModalOpen}}" bindtap="onExportCancel">
    <view class="export-modal-panel" catchtap="onExportModalNoop">
      <view class="export-modal-title">选择导出指标</view>
      <view class="export-modal-hint">可选多个指标，导出为单文件</view>
      <view class="export-range-row">
        <text class="export-range-label">时段：</text>
        <view
          wx:for="{{ranges}}"
          wx:key="key"
          class="export-range-chip {{exportRange === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onExportRangeTap"
        >{{item.label}}</view>
      </view>
      <scroll-view scroll-y class="export-modal-list">
        <view
          wx:for="{{exportMetrics}}"
          wx:key="key"
          class="export-item {{item.checked ? 'checked' : ''}}"
          data-index="{{index}}"
          bindtap="onExportMetricToggle"
        >
          <text class="export-checkbox">{{item.checked ? '☑' : '☐'}}</text>
          <text class="export-item-label">{{item.label}}</text>
          <text class="export-item-unit">{{item.unit}}</text>
        </view>
      </scroll-view>
      <view class="export-modal-actions">
        <text class="export-select-all" bindtap="onExportSelectAll">全选</text>
        <view class="export-btns">
          <text class="export-btn-cancel" bindtap="onExportCancel">取消</text>
          <text class="export-btn-confirm" bindtap="onExportConfirm">{{exporting ? '导出中...' : '确认导出'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>