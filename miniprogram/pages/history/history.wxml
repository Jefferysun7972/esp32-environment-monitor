<view class="container">
  <view class="controls">
    <view class="section-title">时间范围</view>
    <view class="chip-row">
      <view
        wx:for="{{ranges}}"
        wx:key="key"
        class="chip {{selectedRange === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onRangeTap"
      >{{item.label}}</view>
    </view>

    <view class="section-title">指标选择</view>
    <view class="chip-row wrap">
      <view
        wx:for="{{metrics}}"
        wx:key="key"
        class="chip {{selectedMetric === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onMetricTap"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="chart-container">
    <canvas
      type="2d"
      id="historyCanvas"
      class="chart-canvas"
      style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
    ></canvas>
    <view wx:if="{{loading}}" class="overlay">
      <text class="loading">加载中...</text>
    </view>
    <view wx:elif="{{!chartData || chartData.length === 0}}" class="overlay">
      <text class="empty-text">暂无数据</text>
      <text class="empty-hint">请确保 ESP32 正在运行</text>
    </view>
  </view>

  <view class="data-table" wx:if="{{tableData && tableData.length > 0}}">
    <view class="section-title">数据明细</view>
    <view class="table-header">
      <text class="col-time">时间</text>
      <text class="col-val">AM2020DY</text>
      <text class="col-val">SEN68</text>
    </view>
    <scroll-view scroll-y class="table-body">
      <view
        wx:for="{{tableData}}"
        wx:key="displayTime"
        wx:for-item="row"
        class="table-row"
      >
        <text class="col-time">{{row.displayTime}}</text>
        <text class="col-val">{{row.am2020dy !== undefined ? row.am2020dy : '--'}} {{metricUnit}}</text>
        <text class="col-val">{{row.SEN68 !== undefined ? row.SEN68 : '--'}} {{metricUnit}}</text>
      </view>
    </scroll-view>
  </view>
</view>