<view class="container">
  <view class="controls">
    <view class="section-title">时间范围</view>
    <view class="chip-row">
      <view
        wx:for="{{ranges}}"
        wx:key="key"
        class="chip {{selectedRange === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onRangeTap"
      >{{item.label}}</view>
    </view>

    <view class="section-title">指标选择</view>
    <view class="chip-row wrap">
      <view
        wx:for="{{metrics}}"
        wx:key="key"
        class="chip {{selectedMetric === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onMetricTap"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="chart-container">
    <canvas
      type="2d"
      id="historyCanvas"
      class="chart-canvas"
      style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
      bindtouchstart="onCanvasTouch"
      bindtouchmove="onCanvasTouch"
      bindtouchend="onCanvasTouchEnd"
    ></canvas>
    <view wx:if="{{loading}}" class="overlay">
      <text class="loading">加载中...</text>
    </view>
    <view wx:elif="{{!chartData || chartData.length === 0}}" class="overlay">
      <text class="empty-text">暂无数据</text>
      <text class="empty-hint">请确保 ESP32 正在运行</text>
    </view>
  </view>

  <view class="stats-bar" wx:if="{{stats}}">
    <view class="section-title">统计摘要</view>
    <view class="stats-grid">
      <view class="stats-card">
        <text class="stats-sensor">AM2020DY</text>
        <view class="stats-row">
          <view class="stats-item">
            <text class="stats-label">最小</text>
            <text class="stats-value min">{{stats.am2020dy.min}}</text>
          </view>
          <view class="stats-item">
            <text class="stats-label">最大</text>
            <text class="stats-value max">{{stats.am2020dy.max}}</text>
          </view>
          <view class="stats-item">
            <text class="stats-label">平均</text>
            <text class="stats-value avg">{{stats.am2020dy.avg}}</text>
          </view>
        </view>
      </view>
      <view class="stats-card">
        <text class="stats-sensor">SEN68</text>
        <view class="stats-row">
          <view class="stats-item">
            <text class="stats-label">最小</text>
            <text class="stats-value min">{{stats.sen68.min}}</text>
          </view>
          <view class="stats-item">
            <text class="stats-label">最大</text>
            <text class="stats-value max">{{stats.sen68.max}}</text>
          </view>
          <view class="stats-item">
            <text class="stats-label">平均</text>
            <text class="stats-value avg">{{stats.sen68.avg}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="data-table" wx:if="{{tableData && tableData.length > 0}}">
    <view class="table-title-row">
    <view class="section-title">数据明细</view>
    <view class="export-btn" bindtap="onExportCsv">导出 CSV</view>
  </view>

    <view class="table-header">
      <text class="col-time">时间</text>
      <text class="col-val">AM2020DY</text>
      <text class="col-val">SEN68</text>
    </view>
    <scroll-view scroll-y class="table-body">
      <view
        wx:for="{{tableData}}"
        wx:key="displayTime"
        wx:for-item="row"
        class="table-row"
      >
        <text class="col-time">{{row.displayTime}}</text>
        <text class="col-val">{{row.am2020dy !== undefined ? row.am2020dy : '--'}} {{metricUnit}}</text>
        <text class="col-val">{{row.SEN68 !== undefined ? row.SEN68 : '--'}} {{metricUnit}}</text>
      </view>
    </scroll-view>
  </view>
</view>