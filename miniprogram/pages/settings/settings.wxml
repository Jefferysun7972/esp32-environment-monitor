<view class="container {{pageTheme === 'dark' ? 'theme-dark' : ''}}">
  <view class="section">
    <view class="section-title">外观</view>
    <view class="setting-item">
      <view class="setting-info">
        <text class="setting-label">深色模式</text>
        <text class="setting-desc">切换深色/浅色主题</text>
      </view>
      <switch checked="{{theme === 'dark'}}" bindchange="onThemeChange" color="#1a73e8"/>
    </view>
  </view>

  <view class="section">
    <view class="section-title">单位</view>
    <view class="setting-item">
      <view class="setting-info">
        <text class="setting-label">{{isFahrenheit ? '华氏度 (°F)' : '摄氏度 (°C)'}}</text>
        <text class="setting-desc">当前温度单位为{{isFahrenheit ? '华氏度' : '摄氏度'}}</text>
      </view>
      <switch checked="{{isFahrenheit}}" bindchange="onTempUnitChange" color="#1a73e8"/>
    </view>
  </view>

  <view class="section">
    <view class="section-title">关于</view>
    <view class="setting-item">
      <view class="setting-info">
        <text class="setting-label">传感器对比测试</text>
        <text class="setting-desc">版本 1.3.0 · 全自动传感器发现</text>
      </view>
    </view>
    <view class="setting-item">
      <view class="setting-info">
        <text class="setting-label">分享给朋友</text>
        <text class="setting-desc">邀请朋友查看传感器数据</text>
      </view>
      <button class="share-btn" open-type="share" plain="true">
        <text class="setting-arrow">›</text>
      </button>
    </view>
  </view>
</view>