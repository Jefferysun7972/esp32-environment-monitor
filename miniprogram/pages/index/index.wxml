<view class="container">
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <text class="header-title">传感器对比测试</text>
      <text class="header-subtitle">Sensor Comparison Test</text>
      <view class="status-row">
        <view class="status-dot {{connected ? 'on' : 'off'}}"></view>
        <text class="status-text">{{connected ? '在线' : '离线'}}</text>
        <text class="update-text" wx:if="{{lastUpdate}}">{{lastUpdate}} 更新</text>
      </view>
    </view>
  </view>

  <view class="filter-bar">
    <view class="filter-chip {{item.active ? 'active' : ''}}" 
          wx:for="{{sensorFilters}}" wx:key="id"
          data-id="{{item.id}}" bindtap="onSensorToggle"
          style="border-color:{{item.color}};{{item.active ? 'background:' + item.color + ';color:#fff;' : 'color:' + item.color + ';'}}">
      <text>{{item.displayLabel}}</text>
    </view>
  </view>

  <view class="pull-hint" bindtap="onRefresh">
    <text class="pull-hint-text">点击刷新数据</text>
  </view>

  <view class="card" wx:for="{{sensorCards}}" wx:key="id" wx:if="{{item.visible}}">
    <view class="card-header">
      <view class="card-icon" style="background:{{item.iconBg}};color:{{item.iconColor}}">{{item.shortLabel}}</view>
      <view class="card-title-group">
        <text class="card-title">{{item.label}}</text>
        <text class="card-model">{{item.description}}</text>
      </view>
      <view class="card-badge" style="background:{{item.iconBg}};color:{{item.iconColor}}">{{item.paramCount}}参数</view>
    </view>

    <view class="grid {{row.cols === 2 ? 'grid-2' : 'grid-3'}}" wx:for="{{item.rows}}" wx:for-item="row" wx:key="rowKey">
      <view class="metric" wx:for="{{row.metrics}}" wx:for-item="m" wx:key="key">
        <text class="metric-label">{{m.label}}</text>
        <text class="metric-value {{m.cssClass}}">{{m.value}}<text class="metric-unit">{{m.unit}}</text></text>
      </view>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">ESP32 Sensor Comparison v1.7.0</text>
  </view>
</view>