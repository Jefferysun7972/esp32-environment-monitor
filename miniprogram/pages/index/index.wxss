.container {
  background: linear-gradient(180deg, #e8f0fe 0%, #f5f5f5 30%);
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* Header */
.header {
  position: relative;
  padding: 60rpx 40rpx 40rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: -80rpx;
  left: -40rpx;
  right: -40rpx;
  bottom: 0;
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-content {
  position: relative;
  z-index: 1;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}

.status-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  gap: 12rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.status-dot.on {
  background: #69f0ae;
  box-shadow: 0 0 12rpx rgba(105, 240, 174, 0.6);
}

.status-dot.off {
  background: #ff5252;
  box-shadow: 0 0 12rpx rgba(255, 82, 82, 0.6);
}

.status-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.update-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: auto;
}

/* Pull Hint */
.pull-hint {
  text-align: center;
  padding: 16rpx 0;
}

.pull-hint-text {
  font-size: 24rpx;
  color: #1a73e8;
  padding: 12rpx 40rpx;
  background: rgba(26, 115, 232, 0.08);
  border-radius: 40rpx;
}

/* Card */
.card {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.am2020dy-card {
  border-top: 6rpx solid #1a73e8;
}

.sen68-card {
  border-top: 6rpx solid #00bfa5;
}

.card-header {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx 20rpx;
  gap: 16rpx;
}

.card-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.am2020dy-icon {
  background: linear-gradient(135deg, #1a73e8, #4a90d9);
}

.sen68-icon {
  background: linear-gradient(135deg, #00bfa5, #009688);
}

.card-title-group {
  flex: 1;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.card-model {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 2rpx;
}

.card-badge {
  font-size: 22rpx;
  color: #fff;
  background: #1a73e8;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.sen68-badge {
  background: #00bfa5;
}

/* Grid */
.grid {
  display: flex;
  padding: 0 28rpx 20rpx;
  gap: 16rpx;
}

.grid-3 {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.metric {
  flex: 1;
  text-align: center;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
}

.metric-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.metric-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.metric-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #999;
  margin-left: 4rpx;
}

/* Metric Colors */
.metric-value.temp {
  color: #ff6d00;
}

.metric-value.humi {
  color: #1a73e8;
}

.metric-value.pm {
  color: #6a1b9a;
}

.metric-value.tvoc {
  color: #c62828;
}

.metric-value.gas {
  color: #2e7d32;
}

.metric-value.hcho {
  color: #e65100;
}

/* Footer */
.footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #bbb;
}