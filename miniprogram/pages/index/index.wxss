page {
  background: #f5f5f5;
}

.container {
  background: #f5f5f5;
  min-height: 100vh;
  min-height: 100dvh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* Header */
.header {
  position: relative;
  padding: 120rpx 40rpx 40rpx;
  margin: 0 -24rpx 24rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: -80rpx;
  left: -40rpx;
  right: -40rpx;
  bottom: 0;
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-content {
  position: relative;
  z-index: 1;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}



/* Controls */
.controls {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* Filter Bar */
.filter-bar {
  display: flex;
  gap: 16rpx;
}

.filter-chip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  border: 2rpx solid;
  font-size: 22rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  text-align: center;
}

.filter-chip.active {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* Pull Hint */
.pull-hint {
  text-align: center;
  padding: 16rpx 0 0;
}

.pull-hint-text {
  font-size: 24rpx;
  color: #1a73e8;
  padding: 12rpx 40rpx;
  background: rgba(26, 115, 232, 0.08);
  border-radius: 40rpx;
}

/* Card */
.card {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  border-top: 4rpx solid #1a73e8;
}

.card-header {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx 20rpx;
  gap: 16rpx;
}

.card-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.card-title-group {
  flex: 1;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.card-model {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 2rpx;
}

.card-badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

/* Grid */
.grid {
  display: flex;
  padding: 0 28rpx 20rpx;
  gap: 16rpx;
}

.grid-2 {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.grid-3 {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.metric {
  flex: 1;
  text-align: center;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  transition: all 0.3s ease;
}

.metric.warn {
  background: #fff8e1;
  box-shadow: 0 0 0 2rpx #ffc107 inset;
}

.metric.danger {
  background: #ffebee;
  box-shadow: 0 0 0 2rpx #f44336 inset;
  animation: danger-pulse 1.5s ease-in-out infinite;
}

@keyframes danger-pulse {
  0%, 100% { box-shadow: 0 0 0 2rpx #f44336 inset; }
  50% { box-shadow: 0 0 0 4rpx rgba(244, 67, 54, 0.4) inset; }
}

.metric-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.metric-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.metric-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #999;
  margin-left: 4rpx;
}

/* Metric Colors */
.metric-value.temp {
  color: #ff6d00;
}

.metric-value.humi {
  color: #1a73e8;
}

.metric-value.pm {
  color: #6a1b9a;
}

.metric-value.tvoc {
  color: #c62828;
}

.metric-value.gas {
  color: #2e7d32;
}

.metric-value.hcho {
  color: #e65100;
}

.metric-value.pressure {
  color: #006064;
}

/* Footer */
.footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #bbb;
}

/* Loading State - 加载状态 */
.loading-hint {
  text-align: center;
  padding: 60rpx 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.theme-dark .loading-text {
  color: #888;
}

/* Dark Mode - 完整优化 */
page .container.theme-dark,
.container.theme-dark {
  background: #1a1a2e !important;
}

.theme-dark .header-bg {
  background: linear-gradient(135deg, #0d47a1 0%, #0a0a1a 100%);
}

.theme-dark .header-title,
.theme-dark .header-subtitle {
  color: #e0e0e0;
}

/* 卡片样式优化 */
.theme-dark .card {
  background: #252540;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.4);
  border-top-color: #1a5fb8;
}

.theme-dark .card-header {
  border-bottom-color: #333;
  color: #e0e0e0;
}

.theme-dark .card-title {
  color: #f0f0f0;
  font-weight: 700;
}

.theme-dark .card-model {
  color: #999;
}

.theme-dark .card-badge {
  background: rgba(255, 255, 255, 0.1) !important;
  color: #ccc !important;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

/* 网格和指标优化 */
.theme-dark .grid {
  border-top-color: #333;
}

.theme-dark .grid-2,
.theme-dark .grid-3 {
  border-top-color: #333;
}

.theme-dark .metric {
  background: #2a2a45;
  border: 1rpx solid transparent;
  transition: all 0.3s ease;
}

.theme-dark .metric.warn {
  background: #3d3418;
  box-shadow: 0 0 0 2rpx #ff9800 inset;
}

.theme-dark .metric.danger {
  background: #3d1818;
  box-shadow: 0 0 0 2rpx #ef5350 inset;
  animation: danger-pulse-dark 1.5s ease-in-out infinite;
}

@keyframes danger-pulse-dark {
  0%, 100% { box-shadow: 0 0 0 2rpx #ef5350 inset; }
  50% { box-shadow: 0 0 0 6rpx rgba(239, 83, 80, 0.3) inset; }
}

.theme-dark .metric-label {
  color: #aaa;
}

.theme-dark .metric-value {
  color: #e0e0e0;
}

.theme-dark .metric-unit {
  color: #888;
}

/* Controls 深色模式 */
.theme-dark .controls {
  background: #252540;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
}

/* 过滤器优化 */
.theme-dark .filter-chip {
  background: transparent;
  color: #aaa;
  border-color: #555;
  box-shadow: none;
}

.theme-dark .filter-chip.active {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

/* 其他元素优化 */
.theme-dark .footer-text {
  color: #666;
}

.theme-dark .pull-hint-text {
  color: #888;
  background: rgba(26, 115, 232, 0.12);
}

/* 高对比度模式 */
.container.high-contrast .header-title,
.container.high-contrast .header-subtitle {
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.5);
}

.container.high-contrast .metric-label {
  color: #333;
  font-weight: 600;
}

.container.theme-dark.high-contrast .metric-label {
  color: #fff;
  font-weight: 600;
}

.container.high-contrast .metric-value {
  color: #000;
  font-weight: 700;
}

.container.theme-dark.high-contrast .metric-value {
  color: #fff;
  font-weight: 700;
}

.container.high-contrast .card-title {
  color: #000;
  font-weight: 700;
}

.container.theme-dark.high-contrast .card-title {
  color: #fff;
  font-weight: 700;
}