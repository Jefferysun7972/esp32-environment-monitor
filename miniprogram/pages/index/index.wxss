.container {
  background: linear-gradient(180deg, #e8f0fe 0%, #f5f5f5 30%);
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* Header */
.header {
  position: relative;
  padding: 60rpx 40rpx 40rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: -80rpx;
  left: -40rpx;
  right: -40rpx;
  bottom: 0;
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-content {
  position: relative;
  z-index: 1;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}

.status-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  gap: 12rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.status-dot.on {
  background: #69f0ae;
  box-shadow: 0 0 12rpx rgba(105, 240, 174, 0.6);
}

.status-dot.off {
  background: #ff5252;
  box-shadow: 0 0 12rpx rgba(255, 82, 82, 0.6);
}

.status-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.update-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: auto;
}

.cache-badge {
  font-size: 18rpx;
  color: #ff9800;
  background: rgba(255, 152, 0, 0.15);
  border: 1rpx solid rgba(255, 152, 0, 0.3);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 6rpx;
}

.temp-toggle {
  margin-left: auto;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  padding: 4rpx 10rpx;
  transition: all 0.2s ease;
}

.temp-toggle-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  transition: color 0.2s ease;
}

.temp-toggle-label.active {
  color: #fff;
  font-weight: 600;
}

.temp-toggle-divider {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  margin: 0 4rpx;
}

/* Filter Bar */
.filter-bar {
  display: flex;
  padding: 12rpx 24rpx;
  gap: 16rpx;
}

.filter-chip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  border: 2rpx solid;
  font-size: 22rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  text-align: center;
}

.filter-chip.active {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* Pull Hint */
.pull-hint {
  text-align: center;
  padding: 16rpx 0;
}

.pull-hint-text {
  font-size: 24rpx;
  color: #1a73e8;
  padding: 12rpx 40rpx;
  background: rgba(26, 115, 232, 0.08);
  border-radius: 40rpx;
}

/* Card */
.card {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  border-top: 4rpx solid #1a73e8;
}

.card-header {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx 20rpx;
  gap: 16rpx;
}

.card-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.card-title-group {
  flex: 1;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.card-model {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 2rpx;
}

.card-badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

/* Grid */
.grid {
  display: flex;
  padding: 0 28rpx 20rpx;
  gap: 16rpx;
}

.grid-2 {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.grid-3 {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.metric {
  flex: 1;
  text-align: center;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  transition: all 0.3s ease;
}

.metric.warn {
  background: #fff8e1;
  box-shadow: 0 0 0 2rpx #ffc107 inset;
}

.metric.danger {
  background: #ffebee;
  box-shadow: 0 0 0 2rpx #f44336 inset;
  animation: danger-pulse 1.5s ease-in-out infinite;
}

@keyframes danger-pulse {
  0%, 100% { box-shadow: 0 0 0 2rpx #f44336 inset; }
  50% { box-shadow: 0 0 0 4rpx rgba(244, 67, 54, 0.4) inset; }
}

.metric-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.metric-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.metric-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #999;
  margin-left: 4rpx;
}

/* Metric Colors */
.metric-value.temp {
  color: #ff6d00;
}

.metric-value.humi {
  color: #1a73e8;
}

.metric-value.pm {
  color: #6a1b9a;
}

.metric-value.tvoc {
  color: #c62828;
}

.metric-value.gas {
  color: #2e7d32;
}

.metric-value.hcho {
  color: #e65100;
}

.metric-value.pressure {
  color: #006064;
}

/* Footer */
.footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #bbb;
}

/* Dark Mode */
.theme-dark .container {
  background: linear-gradient(180deg, #16213e 0%, #1a1a2e 30%);
}

.theme-dark .header-bg {
  background: linear-gradient(135deg, #0d47a1 0%, #0a0a1a 100%);
}

.theme-dark .header-title,
.theme-dark .header-subtitle {
  color: #e0e0e0;
}

.theme-dark .status-text {
  color: rgba(255, 255, 255, 0.7);
}

.theme-dark .card {
  background: #252540;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.3);
}

.theme-dark .card-header {
  border-bottom-color: #333;
  color: #e0e0e0;
}

.theme-dark .card-sensor-name {
  color: #e0e0e0;
}

.theme-dark .card-sensor-desc {
  color: #888;
}

.theme-dark .metric {
  background: #2a2a45;
  border-color: #333;
}

.theme-dark .metric-label {
  color: #aaa;
}

.theme-dark .metric-value {
  color: #e0e0e0;
}

.theme-dark .metric-unit {
  color: #888;
}

.theme-dark .grid {
  border-top-color: #333;
}

.theme-dark .footer-text {
  color: #666;
}

.theme-dark .pull-hint-text {
  color: #888;
}

.theme-dark .filter-chip {
  background: #2a2a45;
  color: #aaa;
}