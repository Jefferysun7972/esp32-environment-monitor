page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

page.theme-dark {
  background-color: #1a1a2e;
}

.theme-dark .container {
  background: linear-gradient(180deg, #16213e 0%, #1a1a2e 30%);
}

.theme-dark .card {
  background: #252540;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.3);
}

.theme-dark .metric {
  background: #2a2a45;
}

.theme-dark .metric-label {
  color: #aaa;
}

.theme-dark .metric-value {
  color: #e0e0e0;
}